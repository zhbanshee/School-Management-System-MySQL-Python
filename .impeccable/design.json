  "narrative": {
    "northStar": "The Campus Handbook",
    "overview": "The calm precision of a campus handbook, translated into a daily school workspace. Warm paper, pine navigation and literary headings give school administration a human voice, while compact sans-serif records keep the work clear.\n\nThe system is restrained and lightly ruled. Color carries location and status; typography separates welcome and orientation from editing and inspection. Small contextual illustrations belong to the school world, while working controls remain direct.",
    "keyCharacteristics": [
      "Literary serif orientation paired with precise sans-serif records.",
      "Warm paper and pine with quiet botanical accents.",
      "Flat bordered panels, compact tables and visible keyboard states."
    ],
    "rules": [
      {
        "name": "The Working Ink Rule",
        "body": "Use ink for records and pine for navigation and primary actions; reserve pale status colors for labeled states.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use the serif for orientation and the sans for working data, labels and controls.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep ordinary panels flat; reserve diffuse shadows for dialogs and notifications.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the serif/sans division between orientation and records.",
      "Do pair status colors with explicit text and keep numeric records tabular.",
      "Do retain visible focus rings, labeled icon actions and horizontal scrolling for wide tables.",
      "Do use the final muted text token for secondary labels and placeholders."
    ],
    "donts": [
      "Don't turn ordinary data panels into floating shadow cards.",
      "Don't substitute decorative display typography for table text or form labels.",
      "Don't hide record columns by squeezing their text below the implemented scale."
    ]
  }
}
