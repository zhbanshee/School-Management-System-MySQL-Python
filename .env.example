# New web registrations create private SQLite workspaces.
# MySQL access requires a locally provisioned account (see README).
SCHOOL_DB=sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=SchoolManagementSystem

# Set true only when serving over HTTPS.
SCHOOL_COOKIE_SECURE=false
# Optional absolute directory for private account/session/workspace storage:
# SCHOOL_STATE_DIR=/absolute/path/to/private-state
